{
  "sourceLanguage" : "en",
  "strings" : {
    "--" : {
      "comment" : "A placeholder text to display when the walk duration is not available.",
      "isCommentAutoGenerated" : true
    },
    "(%@)" : {
      "comment" : "A sublabel below the potty break message, showing the duration of the last potty break. The argument is the number of minutes since the last potty break.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "comment" : "A text label displaying the time elapsed since the last potty break, followed by the text \"since potty\". The first argument is the string “-- min”, the string “%arg min”, the string “%argh” or the string “%1$argh %2$argm”. The second argument is the string “since potty”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ is napping" : {
      "comment" : "A title that announces the name of the puppy and the current activity. The argument is the name of the puppy.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {
      "comment" : "A label displaying the current streak count. The argument is the current streak count.",
      "isCommentAutoGenerated" : true
    },
    "%lld %@" : {
      "comment" : "A label that describes the number of consecutive outdoor potty events. The argument is the string “outdoor streak”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld %2$@"
          }
        }
      }
    },
    "%lld/%lld" : {
      "comment" : "A label showing the number of meals logged today and the number of meals expected today. The first argument is the count of meals logged today. The second argument is the count of meals expected today.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld/%lld %@" : {
      "comment" : "A label showing the number of meals logged today and the number of meals expected today. The argument is the string “meals”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld/%2$lld %3$@"
          }
        }
      }
    },
