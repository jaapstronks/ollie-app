    "See sleep status, potty timer, meals, and walks at a glance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlafstatus, Pipi-Timer, Mahlzeiten und Spaziergänge auf einen Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve el estado de sueño, temporizador de pipí, comidas y paseos de un vistazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez l'état de sommeil, le minuteur pipi, les repas et les promenades en un coup d'œil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi stato sonno, timer pipì, pasti e passeggiate a colpo d'occhio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk slaapstatus, plastimer, maaltijden en wandelingen in één oogopslag."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sömnstatus, kisstimer, måltider och promenader på en blick."
          }
        }
      }
    },
