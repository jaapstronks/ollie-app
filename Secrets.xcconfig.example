// Secrets.xcconfig
// Copy this file to Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored and should never be committed.

// Sentry DSN for crash reporting
// Get this from: https://sentry.io/settings/[org]/projects/[project]/keys/
SENTRY_DSN = https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID

// TheDogAPI key for breed data
// Get a free API key from: https://thedogapi.com/
THE_DOG_API_KEY = YOUR_API_KEY_HERE
