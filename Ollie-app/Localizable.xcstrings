      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Armen naar de zijkanten. Je puppy moet kiezen: naar de handen kijken (waar snoepjes vandaan komen) of naar je gezicht kijken. Beloon alleen gezichtscontact."
          }
        }
      }
    },
    "As a %@ dog, consider discussing senior screening options and age-appropriate care adjustments.": {
      "localizations": {
        "nl": {
          "stringUnit": {
