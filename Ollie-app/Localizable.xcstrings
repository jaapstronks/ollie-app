    "Small positive experiences make a big difference for %@. Celebrate every tiny win together." : {
      "comment" : "A piece of advice to give to a pet during a sensitive phase. The argument is the pet's name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine positive Erfahrungen machen einen großen Unterschied für %@. Feiere jeden kleinen Erfolg gemeinsam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pequenas experiencias positivas hacen una gran diferencia para %@. Celebra cada pequena victoria juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les petites expériences positives font une grande différence pour %@. Célébrez chaque petite victoire ensemble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piccole esperienze positive fanno una grande differenza per %@. Festeggia ogni piccola vittoria insieme."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liten positive experiences make a big Skillnad for %@. Celebrate every tiny win together."
          }
        }
      }
    },
    "Smart AI Nudges" : {
      "comment" : "Description of a feature that provides gentle reminders to the user based on their puppy's behavior.",
      "isCommentAutoGenerated" : true
    },
    "Smart reminders help you stay ahead of your puppy's needs." : {
      "comment" : "Subtitle for the \"Notifications\" section of the onboarding flow.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intelligente Erinnerungen helfen dir, den Bedürfnissen deines Welpen voraus zu sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios inteligentes te ayudan a anticipar las necesidades de tu cachorro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels intelligents vous aident à anticiper les besoins de votre chiot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria intelligenti ti aiutano ad anticipare i bisogni del cucciolo."
