      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat opnieuw zakken — ze wachten nu iets langer. Herhaal tot ze naar je kijken in plaats van te duiken. Geef dan een vrijlatingwoord ('vrij') en zet de bak neer."
