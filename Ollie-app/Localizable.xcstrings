      }
    },
    "Build duration gradually": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw duur geleidelijk op"
          }
        }
      }
    },
    "Build duration very slowly": {
      "localizations": {
