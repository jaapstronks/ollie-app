    "On %@, %@ came home.": {
      "comment": "A sentence describing when a dog came home. The first argument is the dog's name. The second argument is the date on which the dog came home.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am %@ kam %@ nach Hause."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "On %1$@, %2$@ came home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$@, %2$@ llego a casa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il %1$@, %2$@ è arrivato a casa."
