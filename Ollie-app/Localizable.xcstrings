    "Build Duration: Start with 1 second, then 2, then 5. Reward multiple times while they hold the sit - don't just reward when they get up.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duur opbouwen: Begin met 1 seconde, dan 2, dan 5. Beloon meerdere keren terwijl ze de zit vasthouden - beloon niet alleen wanneer ze opstaan."
          }
        }
      }
    },
    "Build Info": {
      "comment": "A section header for build information.",
