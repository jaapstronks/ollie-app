      "isCommentAutoGenerated": true,
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2-3 korte sessies dagelijks (5 minuten elk). Train niet tijdens de hele wandeling — wijdt training aan korte gefocuste sessies. Wandelingen zijn om de wereld te ervaren."
          }
        }
      }
    },
