    "%@ is already sleeping. Say '%@ woke up' when they wake.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ schläft bereits. Sag '%2$@ ist aufgewacht', wenn er aufwacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya esta durmiendo. Di '%2$@ desperto' cuando despierte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sta già dormendo. Di '%2$@ si è svegliato' quando si sveglia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ slaapt al. Zeg '%2$@ is wakker' wanneer die wakker wordt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dort déjà. Dites « %@ s'est réveillé » quand il se réveille."
          }
        }
      }
    },
    "%@ is sleeping - logged. Say '%@ woke up' when they wake.": {
      "extractionState": "stale",
      "localizations": {
