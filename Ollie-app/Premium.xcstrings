      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Siri, um Ereignisse freihändig zu erfassen und deinen Welpen zu überprüfen. Sag \"Hey Siri\" gefolgt von einem Befehl."
