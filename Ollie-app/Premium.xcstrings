    "%@ wasn't logged as sleeping. Logging wake up anyway.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ war nicht als schlafend erfasst. Aufwachen wird trotzdem erfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no estaba registrado como durmiendo. Registrando despertar de todos modos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non era registrato come addormentato. Registro comunque il risveglio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was niet als slapend gelogd. Wakker worden wordt toch gelogd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'était pas enregistré comme dormant. Enregistrement du réveil quand même."
          }
