    "Save favorite walk spots, see your photos on a map, and discover new places.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere Lieblingsspazierorte, sieh deine Fotos auf einer Karte und entdecke neue Orte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lugares de paseo favoritos, ve tus fotos en un mapa y descubre nuevos lugares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos spots de promenade préférés, voyez vos photos sur une carte et découvrez de nouveaux endroits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i posti preferiti per le passeggiate, vedi le tue foto su una mappa e scopri nuovi luoghi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla favoriete wandelplekken op, bekijk je foto's op een kaart en ontdek nieuwe plekken."
          }
        }
      }
    },
