    "This is your daily dashboard. See today's events, log meals, potty, sleep, and more.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist dein tägliches Dashboard. Sieh die heutigen Ereignisse, erfasse Mahlzeiten, Töpfchen, Schlaf und mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es tu tablero diario. Ve los eventos de hoy, registra comidas, necesidades, sueño y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est votre tableau de bord quotidien. Voyez les événements du jour, enregistrez repas, besoins, sommeil et plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è la tua dashboard giornaliera. Vedi gli eventi di oggi, registra pasti, bisogni, sonno e altro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is je dagelijks dashboard. Bekijk de gebeurtenissen van vandaag, log maaltijden, plasjes, slaap en meer."
          }
        }
      }
