    "Let's show you around so you can get the most out of tracking your puppy.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass uns dir zeigen, wie du das Beste aus dem Tracking deines Welpen herausholst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te mostraremos cómo aprovechar al máximo el seguimiento de tu cachorro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez-nous vous faire découvrir comment tirer le meilleur parti du suivi de votre chiot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti mostriamo come ottenere il massimo dal tracciamento del tuo cucciolo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laten we je rondleiden zodat je het meeste uit het bijhouden van je puppy kunt halen."
          }
        }
      }
    },
    "Manage appointments, contacts, and track important milestones.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Termine, Kontakte und wichtige Meilensteine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Administra citas, contactos y sigue hitos importantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les rendez-vous, les contacts et suivez les étapes importantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci appuntamenti, contatti e traguardi importanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer afspraken, contacten en houd belangrijke mijlpalen bij."
          }
        }
      }
    },
