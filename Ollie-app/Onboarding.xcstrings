    "Smart reminders help you stay ahead of your puppy's needs.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligente Erinnerungen helfen dir, den Bedürfnissen deines Welpen voraus zu sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios inteligentes te ayudan a anticiparte a las necesidades de tu cachorro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des rappels intelligents vous aident à anticiper les besoins de votre chiot."
          }
