    "Track meals, potty, sleep & walks — and actually understand what your puppy needs.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Mahlzeiten, Pipi, Schlaf & Spaziergänge — und verstehe endlich was dein Welpe braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra comidas, pipí, sueño y paseos — y entiende realmente lo que tu cachorro necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les repas, les besoins, le sommeil et les promenades — et comprenez vraiment les besoins de votre chiot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra pappa, pipi, nanna e passeggiate — e capisci davvero di cosa ha bisogno il tuo cucciolo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd maaltijden, plasjes, slaap en wandelingen bij — en begrijp eindelijk wat je pup nodig heeft."
