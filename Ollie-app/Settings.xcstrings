    "Are you sure you want to stop sharing? The other person will lose access.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du sicher, dass du aufhören willst zu teilen? Die andere Person verliert den Zugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres dejar de compartir? La otra persona perderá el acceso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je wilt stoppen met delen? De andere persoon verliest dan toegang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler smettere di condividere? L'altra persona perderà l'accesso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment arrêter le partage ? L'autre personne perdra l'accès."
          }
        }
      }
    },
