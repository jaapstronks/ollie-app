    "Background shifts from cool mornings to warm evenings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrund wechselt von kühlen Morgen zu warmen Abenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fondo cambia de mañanas frescas a tardes cálidas."
          }
        },
        "fr" : {
          "stringUnit" : {
