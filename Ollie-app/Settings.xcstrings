    "The well-known '5-minute rule' — adjust based on your puppy's energy level.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bekannte '5-Minuten-Regel' — anpassen basierend auf dem Energielevel deines Welpen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conocida 'regla de los 5 minutos' — ajusta según el nivel de energía de tu cachorro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bekende '5-minutenregel' — pas aan op basis van het energieniveau van je pup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota 'regola dei 5 minuti' — adatta in base al livello di energia del tuo cucciolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle bien connue des « 5 minutes » — ajustez selon le niveau d'énergie de votre chiot."
          }
        }
      }
    },
    "The well-known '5-minute rule' — puppies can walk for a maximum of 5 minutes per month of age per session. Adjust based on your puppy's energy level.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bekannte '5-Minuten-Regel' — Welpen können maximal 5 Minuten pro Lebensmonat pro Einheit spazieren gehen. Anpassen basierend auf dem Energielevel deines Welpen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conocida 'regla de los 5 minutos' — los cachorros pueden pasear un máximo de 5 minutos por mes de edad por sesión. Ajusta según el nivel de energía de tu cachorro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bekende '5-minutenregel' — puppy's kunnen maximaal 5 minuten per maand leeftijd per sessie wandelen. Pas aan op basis van het energieniveau van je pup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota 'regola dei 5 minuti' — i cuccioli possono camminare per un massimo di 5 minuti per mese di età a sessione. Adatta in base al livello di energia del tuo cucciolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle bien connue des « 5 minutes » — les chiots peuvent marcher maximum 5 minutes par mois d'âge par session. Ajustez selon le niveau d'énergie de votre chiot."
          }
        }
      }
    },
