    "Small positive experiences make a big difference for %@. Celebrate every tiny win together.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine positive Erfahrungen machen einen großen Unterschied für %@. Feiere jeden kleinen Erfolg gemeinsam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pequenas experiencias positivas marcan una gran diferencia para %@. Celebra cada pequeno logro juntos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccole esperienze positive fanno una grande differenza per %@. Festeggia ogni piccolo successo insieme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine positieve ervaringen maken nu een groot verschil voor %@. Vier samen elk succesje."
