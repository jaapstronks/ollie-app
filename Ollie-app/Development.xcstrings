    "Debug overrides are only available in development builds and persist across app launches.": {
      "comment": "A footer label explaining the purpose of the debug override feature.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug-Überschreibungen sind nur in Entwicklungsversionen verfügbar und bleiben über App-Starts hinweg bestehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las anulaciones de depuracion solo estan disponibles en compilaciones de desarrollo y persisten entre lanzamientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les remplacements de débogage ne sont disponibles que dans les builds de développement et persistent entre les lancements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sovrascritture debug sono disponibili solo nelle build di sviluppo e persistono tra i lanci dell'app."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug overrides are only available I development builds and persist across app launches."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug-overschrijvingen zijn alleen beschikbaar in ontwikkelversies en blijven behouden na het herstarten van de app."
