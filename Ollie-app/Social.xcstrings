    "Sit near a playground at comfortable distance, reward calm watching. Parallel walks with calm adult dogs. Brief, controlled interactions only occasionally.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich in angenehmer Entfernung bei einem Spielplatz, belohne ruhiges Beobachten. Parallele Spaziergänge mit ruhigen erwachsenen Hunden. Kurze, kontrollierte Interaktionen nur gelegentlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siéntate cerca de un parque a distancia cómoda, premia la observación tranquila. Paseos paralelos con perros adultos tranquilos. Interacciones breves y controladas solo ocasionalmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous près d'une aire de jeux à distance confortable, récompensez l'observation calme. Promenades parallèles avec des chiens adultes calmes. Interactions brèves et contrôlées seulement occasionnellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siediti vicino a un parco giochi a distanza confortevole, premia l'osservazione calma. Passeggiate parallele con cani adulti calmi. Interazioni brevi e controllate solo occasionalmente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga op comfortabele afstand bij een speeltuin zitten, beloon rustig kijken. Parallelle wandelingen met rustige volwassen honden. Korte, gecontroleerde interacties alleen af en toe."
          }
        }
      }
    },
