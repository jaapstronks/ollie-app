          }
        }
      }
    },
    "The goal: walk past a playground without breaking stride.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel: An einem Spielplatz vorbeigehen, ohne den Schritt zu verlangsamen."
          }
        },
        "es": {
          "stringUnit": {
