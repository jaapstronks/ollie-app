    "Most socialization should be observation from a distance. Reward disengagement and looking back at you, not excitement.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meiste Sozialisierung sollte Beobachtung aus der Ferne sein. Belohne das Abwenden und Zurückschauen zu dir, nicht Aufregung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor parte de la socialización debe ser observación a distancia. Premia el desapego y mirarte, no la excitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart de la socialisation devrait être de l'observation à distance. Récompensez le désengagement et le regard vers vous, pas l'excitation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte della socializzazione dovrebbe essere osservazione a distanza. Premia il disimpegno e il guardarti, non l'eccitazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meeste socialisatie moet observatie van een afstand zijn. Beloon loslaten en naar jou terugkijken, niet opwinding."
          }
        }
      }
    },
