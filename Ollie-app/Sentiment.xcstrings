      "extractionState" : "stale",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benchtraining helpt bij zindelijkheidstraining - puppy's vermijden van nature hun hol te bevuilen."
