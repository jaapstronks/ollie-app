    "Clean up calmly without scolding. Punishment creates fear, not learning." : {
      "extractionState" : "stale",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruim rustig op zonder te schelden. Straffen creëert angst, geen leren."
