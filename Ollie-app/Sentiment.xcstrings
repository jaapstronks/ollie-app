        }
      }
    },
    "Clear main focus" : {
      "extractionState" : "stale",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wis hoofdfocus"
          }
        }
      }
    },
    "Cover the crate with a blanket to create a den-like feeling. Leave one side open for airflow." : {
      "extractionState" : "stale",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedek de bench met een deken voor een holgevoel. Laat één kant open voor ventilatie."
          }
        }
      }
    },
    "Crate builds confidence" : {
      "extractionState" : "stale",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bench bouwt zelfvertrouwen"
