{
  "sourceLanguage": "en",
  "strings": {
    "%@ wants to share their dog with you. This will add their dog to your profile list alongside %@.": {
      "comment": "Text displayed in an alert when a user is invited to share a dog with them, and they don't already have a profile for that dog. The first argument is the name of the dog's owner. The second argument is the name of the user's existing dog.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ wants to share their dog with you. This will add their dog to your profile list alongside %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wil hun hond met je delen. Dit voegt hun hond toe aan je profiellijst naast %2$@."
          }
        }
      },
      "extractionState": "manual"
    },
    "%@ wants to share their dog with you. This will add their dog to your profile list.": {
      "comment": "A message that appears when a user is invited to share their dog with another user, without specifying a name for the other user.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wil hun hond met je delen. Dit voegt hun hond toe aan je profiellijst."
          }
        }
      },
      "extractionState": "manual"
    },
    "%@ wants to share their puppy with you. This will add their dog to your profile list alongside %@.": {
      "comment": "Message shown to users when a non-destructive share invitation is received, explaining that the shared puppy will be added to the user's profile. The argument is the name of the existing puppy in the user's profile, and the second argument is the name of the owner of the shared puppy.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ wants to share their puppy with you. This will add their dog to your profile list alongside %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wil hun pup met je delen. Dit voegt hun hond toe aan je profiellijst naast %2$@."
          }
        }
      }
    },
