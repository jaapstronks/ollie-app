    "You already have a profile for %@. Accepting this share will replace it with the shared dog from %@. Your current profile data will be deleted.": {
      "comment": "Message shown when a user accepts a share that involves replacing their own profile with a profile belonging to another user. The first argument is the name of the user's current profile. The second argument is the name of the user whose profile is being shared.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You already have a profile for %1$@. Accepting this share will replace it with the shared dog from %2$@. Your current profile data will be deleted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al een profiel voor %1$@. Als je deze deeluitnodiging accepteert, wordt het vervangen door de gedeelde hond van %2$@. Je huidige profielgegevens worden verwijderd."
          }
        }
      },
      "extractionState": "manual"
    },
    "You already have a profile for %@. Accepting this share will replace it with the shared puppy from %@. Your current profile data will be deleted.": {
      "comment": "Message shown when a user accepts a cloud share that replaces their existing puppy profile. The first argument is the name of the user's existing puppy profile. The second argument is the name of the user whose puppy was shared.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You already have a profile for %1$@. Accepting this share will replace it with the shared puppy from %2$@. Your current profile data will be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes un perfil para %1$@. Aceptar este compartido lo reemplazara con el cachorro compartido de %2$@. Los datos de tu perfil actual seran eliminados."
