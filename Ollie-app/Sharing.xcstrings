            "value": "Vous avez déjà un profil pour %1$@. Accepter ce partage le remplacera par le chiot partagé de %2$@. Vos données de profil actuelles seront supprimées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al een profiel voor %1$@. Als je deze deeluitnodiging accepteert, wordt het vervangen door de gedeelde pup van %2$@. Je huidige profielgegevens worden verwijderd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have a Profil for %1$@. Accepting denna Dela will replace it with the Delad Valp Från %2$@. Your Aktuell Profil Data will be Raderad."
          }
        }
      }
    },
