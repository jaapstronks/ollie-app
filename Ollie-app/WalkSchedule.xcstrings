    "Walk times adjust based on when the last walk happened. Good for adapting to real-world timing.": {
      "extractionState": "stale",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandeltijden passen zich aan op basis van de laatste wandeling. Ideaal om aan te passen aan de praktijk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaziergangszeiten passen sich an den letzten Spaziergang an. Ideal für flexible Alltagsplanung."
          }
        }
      }
    },
    "Walk times are fixed to the scheduled times. Useful for strict routines or multiple caretakers.": {
      "extractionState": "stale",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandeltijden zijn vastgelegd op de geplande tijden. Handig voor strikte routines of meerdere verzorgers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaziergangszeiten sind fest geplant. Nützlich für strikte Routinen oder mehrere Betreuer."
          }
        }
      }
    },
