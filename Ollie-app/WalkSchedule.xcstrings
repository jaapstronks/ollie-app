    "Walk times adjust based on when the last walk happened. Good for adapting to real-world timing.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaziergangszeiten passen sich an den letzten Spaziergang an. Ideal für flexible Alltagsplanung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los horarios de paseo se ajustan segun cuando fue el ultimo paseo. Ideal para adaptarse a la vida real."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli orari delle passeggiate si adattano in base all'ultima passeggiata. Ideale per adattarsi alla vita reale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandeltijden passen zich aan op basis van de laatste wandeling. Ideaal om aan te passen aan de praktijk."
          }
        }
      }
    },
    "Walk times are fixed to the scheduled times. Useful for strict routines or multiple caretakers.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaziergangszeiten sind fest geplant. Nützlich für strikte Routinen oder mehrere Betreuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los horarios de paseo son fijos. Util para rutinas estrictas o multiples cuidadores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli orari delle passeggiate sono fissi. Utile per routine rigorose o piu persone che si occupano del cane."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandeltijden zijn vastgelegd op de geplande tijden. Handig voor strikte routines of meerdere verzorgers."
          }
        }
      }
    },
