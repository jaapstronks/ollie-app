    "The '5-minute rule' — puppies can walk 5 minutes per month of age per session.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die '5-Minuten-Regel' — Welpen dürfen 5 Minuten pro Lebensmonat pro Spaziergang laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La 'regla de los 5 minutos': los cachorros pueden caminar 5 minutos por mes de edad por sesion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La 'regola dei 5 minuti' — i cuccioli possono camminare 5 minuti per mese di eta per sessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De '5-minutenregel' — puppy's mogen 5 minuten per maand leeftijd per keer wandelen."
          }
        }
      }
    },
