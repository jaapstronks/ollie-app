    "%@ of walks" : {
      "comment" : "A string that combines a time duration (e.g. \"20 minutes\") with the word \"walks\".",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true
    },
    "%@ should wake up soon – walk is due" : {
      "comment" : "A notification to be displayed when a child is expected to wake up, but also when a walk is scheduled.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt zo wakker – tijd voor een wandeling"
          }
        }
      }
    },
    "%@ was clearly loved. We can see it in every walk logged, every milestone celebrated.\n\nWhen you're ready, we can help you create a memory book to remember %@ by." : {
      "comment" : "Confirmation message inside the \"If your dog has passed away...\" section of the Memorial settings screen. The argument is the name of the dog.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was clearly loved. We can see it in every walk logged, every milestone celebrated.\n\nWhen you're ready, we can help you create a memory book to remember %2$@ by."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fue claramente amado. Lo vemos en cada paseo registrado, cada hito celebrado.\n\nCuando estes listo, podemos ayudarte a crear un libro de recuerdos para recordar a %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ était clairement aimé. On le voit dans chaque promenade enregistrée, chaque étape célébrée.\n\nQuand vous serez prêt, nous pouvons vous aider à créer un livre de souvenirs pour vous rappeler de %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ was duidelijk geliefd. We zien het in elke wandeling, elke mijlpaal.\n\nWanneer je er klaar voor bent, kunnen we je helpen een herinneringenboek te maken voor %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ was clearly loved. We can see it I every Promenad logged, every Milstolpe celebrated.\n\nWhen you're ready, we can Hjälp you create a memory book Till remember %2$@ by."
          }
        }
      }
    },
