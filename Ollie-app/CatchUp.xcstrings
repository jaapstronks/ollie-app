          "stringUnit": {
            "state": "translated",
            "value": "Hola! Vamos a ponerte al dia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut ! Mettons-nous à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao! Ti aggiorniamo."
          }
        },
        "nl": {
