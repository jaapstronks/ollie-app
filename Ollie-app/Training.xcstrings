    },
    "Always return to puppy - don't call them to break stay" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe immer zum Welpen zuruck - rufe ihn nicht, um das Bleib zu brechen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre vuelve al cachorro - no lo llames para romper el quieto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez toujours vers le chiot - ne l'appelez pas pour interrompre le reste"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
