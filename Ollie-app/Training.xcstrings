            "value": "Aggiungi le distrazioni per ultime"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg als laatste afleiding toe"
          }
        }
      }
    },
    "Add duration first (stay close but longer)": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst Dauer hinzufugen (nah bleiben, aber langer)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade duración primero (quédate cerca pero más tiempo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord la durée (restez proche mais plus longtemps)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima la durata (resta vicino ma più a lungo)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg eerst duur toe (blijf dichtbij maar langer)"
          }
        }
      }
    },
    "Add the cue 'down' once behavior is reliable": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuge das Kommando 'Platz' hinzu, sobald das Verhalten zuverlassig ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la orden 'túmbate' cuando el comportamiento sea fiable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le signal « couché » une fois le comportement fiable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il comando 'terra' quando il comportamento è affidabile"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg het commando 'af' toe zodra het gedrag betrouwbaar is"
          }
        }
      }
    },
    "Add the cue 'place' or 'bed'": {
      "extractionState": "stale",
