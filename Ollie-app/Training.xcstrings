        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pup gaat naar zijn mand of matje en blijft daar. Geweldig om thuis te kalmeren."
          }
        }
      }
    },
    "Puppy learns to touch their nose to your palm. Useful for positioning and recall.": {
      "extractionState": "stale",
