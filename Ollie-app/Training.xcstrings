        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez tout d'un coup d'œil : état du sommeil, progrès de la propreté et événements à venir. Utilisez le bouton + pour enregistrer rapidement les activités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi tutto a colpo d'occhio: stato del sonno, progressi della pipì e eventi in arrivo. Usa il pulsante + per registrare rapidamente le attività."
          }
        },
        "nl" : {
          "stringUnit" : {
