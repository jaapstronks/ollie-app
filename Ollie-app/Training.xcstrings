    },
    "If puppy freezes, lure them forward with treats" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Welpe erstarrt, mit Leckerlis vorwarts locken"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el cachorro se queda quieto, atráelo hacia adelante con premios"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le chiot se fige, attirez-le avec des friandises"
