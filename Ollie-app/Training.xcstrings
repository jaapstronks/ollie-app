    "Puppy goes to their bed or mat and stays there. Great for settling at home.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Welpe geht zu seinem Bett oder seiner Matte und bleibt dort. Ideal zum Entspannen zu Hause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cachorro va a su cama o alfombra y se queda allí. Genial para calmarse en casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
