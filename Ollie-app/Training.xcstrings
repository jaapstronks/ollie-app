        }
      }
    },
    "Always make coming to you worthwhile": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache es immer lohnenswert, zu dir zu kommen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que venir a ti siempre valga la pena"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites toujours en sorte que venir vers vous en vaille la peine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai sì che venire da te valga sempre la pena"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg dat naar jou toekomen altijd de moeite waard is"
          }
        }
      }
    },
    "Always return to puppy - don't call them to break stay": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe immer zum Welpen zuruck - rufe ihn nicht, um das Bleib zu brechen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre vuelve al cachorro - no lo llames para romper el quieto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez toujours vers le chiot - ne l'appelez pas pour interrompre le reste"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna sempre dal cucciolo - non chiamarlo per interrompere il resta"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Keer altijd terug naar je pup - roep hem niet om het blijven te verbreken"
          }
        }
      }
    },
    "As their head goes up, their bottom goes down": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Kopf hoch geht, geht das Hinterteil runter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando su cabeza sube, su trasero baja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand sa tête monte, son arrière-train descend"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la testa va su, il sedere va giù"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als zijn hoofd omhoog gaat, gaat zijn achterwerk omlaag"
          }
        }
      }
    },
    "Ask for a down on the mat": {
      "extractionState": "stale",
      "localizations": {
