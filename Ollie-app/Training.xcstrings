    },
    "Build duration, distance, and work through distractions" : {
      "comment" : "Subtitle for a training phase where the user is building proof by varying duration, distance, and dealing with distractions.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true
    },
    "Build duration: Start at 1 second of eye contact before clicking. Gradually extend to 3-5 seconds." : {
      "comment" : "How to increase the duration of the 'Watch Me' skill.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouw duur op: begin met 1 seconde oogcontact voor je klikt. Verleng geleidelijk naar 3-5 seconden."
          }
        }
      }
    },
    "Build Duration: Start with 1 second, then 2, then 5. Reward multiple times while they hold the sit - don't just reward when they get up." : {
      "comment" : "Training module - how-to step for building the duration of the 'sit' command.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouw duur op: begin met 1 seconde, dan 2, dan 5. Beloon meerdere keren terwijl ze blijft zitten - niet alleen wanneer ze opstaat."
          }
        }
      }
    },
