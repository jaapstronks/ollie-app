        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites son nom une fois d'une voix joyeuse"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dì il nome una volta con voce allegra"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg zijn naam één keer met een blije stem"
          }
        }
      }
    },
    "Say their name once in a happy, upbeat voice" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
