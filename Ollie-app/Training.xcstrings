          }
        }
      }
    },
    "See everything at a glance: sleep status, potty progress, and upcoming events. Use the + button to quickly log activities." : {
      "comment" : "Message for the Today view introduction tip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh alles auf einen Blick: Schlafstatus, Töpfchenfortschritt und anstehende Ereignisse. Verwende die + Taste, um Aktivitäten schnell zu protokollieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve todo de un vistazo: estado de sueño, progreso del baño y próximos eventos. Usa el botón + para registrar actividades rápidamente."
