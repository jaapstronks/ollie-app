    "Get weekly reminders to practice this skill without tracking progress" : {
      "comment" : "Description of the \"Maintenance Mode\" feature, explaining that it sends weekly reminders to practice a skill without tracking progress.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true
    },
    "Get your puppy comfortable being touched everywhere. Important for vet visits, grooming, and health checks." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewohne deinen Welpen daran, uberall beruhrt zu werden. Wichtig fur Tierarztbesuche, Pflege und Gesundheitschecks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz que tu cachorro se sienta cómodo siendo tocado en todas partes. Importante para visitas al veterinario, aseo y revisiones de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habituez votre chiot à être touché partout. Important pour les visites vétérinaires, le toilettage et les examens de santé."
