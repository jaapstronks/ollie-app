    "Achievements are still tracked even with celebrations turned off. You can view them in your memories.": {
      "comment": "A footer text that explains that achievements are still tracked even when celebrations are disabled. It also mentions that users can view their achievements in their memories.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfolge werden auch bei deaktivierten Feierlichkeiten erfasst. Du kannst sie in deinen Erinnerungen ansehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los logros se siguen registrando aunque las celebraciones esten desactivadas. Puedes verlos en tus recuerdos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les accomplissements sont toujours suivis même avec les célébrations désactivées. Vous pouvez les voir dans vos souvenirs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I traguardi vengono comunque registrati anche con le celebrazioni disattivate. Puoi visualizzarli nei tuoi ricordi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestationer are still tracked even with celebrations turned Av. You can view them I your memories."
          }
        }
      },
      "extractionState": "manual"
    },
