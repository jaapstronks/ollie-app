    "This member will be removed. Events they logged will keep their attribution." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Mitglied wird entfernt. Ereignisse, die es protokolliert hat, behalten ihre Zuordnung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este miembro sera eliminado. Los eventos que registro mantendran su atribucion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce membre sera supprime. Les evenements qu'il a enregistres conserveront leur attribution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo membro sara rimosso. Gli eventi che ha registrato manterranno la loro attribuzione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit lid wordt verwijderd. Gebeurtenissen die ze hebben gelogd behouden hun toewijzing."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna medlem kommer att tas bort. Handelser de loggade behaller sin tillskrivning."
          }
        }
      }
    },
    "Track who logs each event when sharing with family." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolgen Sie, wer jedes Ereignis protokolliert, wenn Sie mit der Familie teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastrea quien registra cada evento cuando compartes con la familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez qui enregistre chaque evenement lors du partage avec la famille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni traccia di chi registra ogni evento quando condividi con la famiglia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd bij wie elke gebeurtenis logt wanneer je deelt met familie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara vem som loggar varje handelse nar du delar med familjen."
          }
