    "Swipe left on a member to edit or delete." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischen Sie nach links, um ein Mitglied zu bearbeiten oder zu loschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia la izquierda en un miembro para editar o eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche sur un membre pour modifier ou supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso sinistra su un membro per modificare o eliminare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links op een lid om te bewerken of verwijderen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep at vanster pa en medlem for att redigera eller ta bort."
